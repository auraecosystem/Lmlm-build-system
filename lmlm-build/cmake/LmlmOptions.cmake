option(LMLM_ENABLE_CUDA "Build the CUDA probe" OFF)
option(LMLM_ENABLE_ROCM "Build the HIP/ROCm probe" OFF)
option(LMLM_ENABLE_METAL "Build the Apple Metal probe" OFF)

set(_lmlm_accelerators 0)
foreach(_backend LMLM_ENABLE_CUDA LMLM_ENABLE_ROCM LMLM_ENABLE_METAL)
  if(${_backend})
    math(EXPR _lmlm_accelerators "${_lmlm_accelerators} + 1")
  endif()
endforeach()
if(_lmlm_accelerators GREATER 1)
  message(FATAL_ERROR "Configure one accelerator backend per build tree.")
endif()
if(LMLM_ENABLE_METAL AND NOT APPLE)
  message(FATAL_ERROR "Metal builds require macOS.")
endif()

message(STATUS "LMLM build fabric: CPU baseline enabled")
message(STATUS "LMLM CUDA: ${LMLM_ENABLE_CUDA}")
message(STATUS "LMLM ROCm/HIP: ${LMLM_ENABLE_ROCM}")
message(STATUS "LMLM Metal: ${LMLM_ENABLE_METAL}")
