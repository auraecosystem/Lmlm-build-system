{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "lmlm-cpu",
      "displayName": "LMLM CPU",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/lmlm-cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "lmlm-cuda",
      "displayName": "LMLM CUDA",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/lmlm-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "LMLM_ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "lmlm-rocm",
      "displayName": "LMLM ROCm / HIP",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/lmlm-rocm",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "LMLM_ENABLE_ROCM": "ON"
      }
    },
    {
      "name": "lmlm-metal",
      "displayName": "LMLM Apple Metal",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build/lmlm-metal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "LMLM_ENABLE_METAL": "ON"
      }
    }
  ]
}
